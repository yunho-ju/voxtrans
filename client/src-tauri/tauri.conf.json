{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/refs/heads/dev/packages/tauri-utils/schema.json",
  "productName": "VoxTrans",
  "version": "0.1.0",
  "identifier": "com.voxtrans.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "VoxTrans",
        "width": 520,
        "height": 440,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {}
}
