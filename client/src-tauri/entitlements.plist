<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Signing with a real certificate turns on the hardened runtime, which
       gates the microphone behind this entitlement. Without it the system
       denies capture even when System Settings shows the permission granted,
       so the app reports a missing permission that the user can see is there. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
